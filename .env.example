# ==============================================================================
# FinCore Environment Configuration Template
# Copy this file to '.env' and provide your actual environment values.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Cryptographic & Security Keys
# Generate fresh keys using:
#   PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/Mac:  openssl rand -base64 48
# ------------------------------------------------------------------------------
# Minimum 48-byte key required for HMAC-SHA384
JWT_SECRET=your_cryptographically_secure_hmac_sha384_jwt_secret_minimum_48_characters

# Minimum 32-character shared secret for east-west microservice security
FINCORE_INTERNAL_SECRET=your_cryptographically_secure_internal_service_secret_32_characters

# Minimum 32-character salt key used for HMAC-SHA256 OTP hashing
OTP_HASH_SECRET=your_cryptographically_secure_otp_hash_salt_secret_32_characters

# ------------------------------------------------------------------------------
# PostgreSQL Database Credentials
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password

# Database URLs (Default local connections)
# In Docker, change 'localhost' to 'host.docker.internal'
SPRING_DATASOURCE_URL_ACCOUNT=jdbc:postgresql://localhost:5432/account_db
SPRING_DATASOURCE_URL_AUTH=jdbc:postgresql://localhost:5432/auth_db
SPRING_DATASOURCE_URL_CUSTOMER=jdbc:postgresql://localhost:5432/customer_db
SPRING_DATASOURCE_URL_TRANSACTION=jdbc:postgresql://localhost:5432/transaction_db

# ------------------------------------------------------------------------------
# Mail Configuration (Optional - for KYC OTP email delivery via auth-service)
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password

# ------------------------------------------------------------------------------
# Service Discovery & Inter-Service URLs
# ------------------------------------------------------------------------------
EUREKA_SERVER_URL=http://localhost:8761/eureka/
CUSTOMER_SERVICE_URL=http://localhost:8081
